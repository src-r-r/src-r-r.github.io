{% layout "_layouts/dgtstatic/base.liquid" %}

{% block title %}Jordan Hewitt's Projects{% endblock %}

{% block "main" %}

<h1 class="page-hero-title">Projects</h1>

<div class="flex flex-wrap">
    {% for project in projects %}
        <div class="border-1 border-solid border-orange-400 m-4 w-full md:w-7/16">
            <div class="card-header p-2">
                <h3 class="font-bold">{{ project.title }}</h3>
            </div>
            <div class="card-body">
                <section class="description p-2" style="height: 100px">
                    <p class="description">{{ project.description }}</p>
                </section>
                <div class="tech tags p-2">
                    {% for tech in project.tech %}
                        <span class="bg-gray-300 m-1 py-1 px-2 rounded-4xl text-xs text-center">
                            {{ tech }}
                        </span>
                    {% endfor %}
                </div>
            </div>
            <div class="border-1 border-solid border-orange-600 text-orange-600 m-4 text-center">
                <a href="{{ project.url }}" class="button full-width" rel="external">Go To Project</a>
            </div>
        </div>
    {% endfor %}
</div>

{% endblock %}
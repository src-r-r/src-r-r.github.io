  <meta property="og:image" content="https://damngood.tech/images/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Damn Good Technology — AI & Automation Expert Jordan Hewitt">

  <!-- Twitter Card Meta Tags -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:site" content="@DamnGoodTech" />
  <meta property="twitter:creator" content="@DamnGoodTech" />
  <meta property="twitter:title" content="{{ social_title | default: 'Damn Good Technology' }}" />
  <meta property="twitter:description" content="{{ social_description | default: 'Jordan Hewitt (Damn Good Technology) is a Portland-based AI & Automation Expert. Ready to superCHARGE your business. Practice kindness. Innovate radically.' }}" />
  <meta property="twitter:image" content="https://damngood.tech/images/og-image.png">
  <meta property="twitter:url" content="https://damngood.tech{{ page.url | replace: "/index.html", "/" }}" />


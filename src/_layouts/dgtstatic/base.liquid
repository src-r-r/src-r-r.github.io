  <!-- Open Graph Meta Tags -->
  <meta property="og:url" content="https://damngood.tech{{ page.url | replace: "/index.html", "/" }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Damn Good Technology" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{ social_title | default: 'Damn Good Technology' }}" />
